{
  "name": "termforge",
  "version": "1.0.0",
  "description": "Terminal harness that restyles your real Windows shell to look like another OS terminal.",
  "main": "index.js",
  "type": "commonjs",
  "bin": { "termforge": "index.js" },
  "scripts": {
    "start": "node index.js",
    "build:exe": "npx caxa --input \".\" --output \"dist/termforge.exe\" --exclude \".git\" \"dist\" \"termforge.zip\" -- \"{{caxa}}/node_modules/.bin/node\" \"{{caxa}}/index.js\""
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "engines": { "node": ">=16" },
  "license": "MIT"
}
